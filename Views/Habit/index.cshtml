@model IEnumerable<CleanLife.Web.Models.Habit>

    <h1>Мои привычки</h1>

    <p>
        <a asp-action="Create">Создать привычку</a>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Статус</th>
                <th>Цель (дней)</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
    {
            <tr>
                <td>@item.Name</td>
                <td>@item.Status</td>
                <td>@item.GoalDays</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Подробнее</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактировать</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                </td>
            </tr>
    }
        </tbody>
    </table>
